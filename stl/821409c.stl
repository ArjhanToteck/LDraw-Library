        vertex -9.2000 0.0000 -1.6000
    endloop
endfacet
facet normal -0.5000 0.0000 0.1250
    outer loop
        vertex -9.2000 0.0000 -1.6000
        vertex -9.2000 -0.1000 -1.6000
        vertex -9.0000 -0.1000 -0.8000
    endloop
endfacet
endsolid GiantLegoRocks
